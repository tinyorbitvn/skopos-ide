{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkoposIDE",
  "version": "0.9.0",
  "identifier": "dev.skopos.ide",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ui dev",
    "beforeBuildCommand": "pnpm -C ui build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "SkoposIDE",
      "width": 1360,
      "height": 860,
      "minWidth": 960,
      "minHeight": 600,
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "LicenseRef-PolyForm-Shield-1.0.0",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../LICENSE": "LICENSE"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMzMyMEExNDI3MEVBQjMKUldTejZuQkNvU0F6ZWdPWjU0N0dGVUNNWSt3MGlkbkNzMzhzMUh2dnNZR3J2TWx6TDM0SUZWTngK",
      "endpoints": ["https://github.com/vanlongme/skopos-ide/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
