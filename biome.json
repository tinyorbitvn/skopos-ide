{
  "$schema": "https://biomejs.dev/schemas/2.6.0/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/generated", "!**/dist"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@thesvg/ui-react",
                  "@thesvg/ui-react/**",
                  "lucide-react",
                  "lucide-react/**"
                ],
                "message": "Import icons from design/icons, the one module that maps them."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["ui/src/design/icons.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
